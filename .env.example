# PostgreSQL Database Connection URL (from Render or Local PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ksrtc_db

# Optional write-endpoint authentication header: X-API-Key
# If set, POST/PUT/PATCH/DELETE requests will require this key.
# If unset or empty, writes are permitted without X-API-Key (useful for local dev).
API_KEY=

# Allowed origins for CORS (comma-separated).
# Include your production React frontend URL (e.g. Vercel) and localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://my-frontend.vercel.app

# Server Port (Render sets this automatically)
PORT=8000
